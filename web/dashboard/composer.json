{
  "name":"reyhanteam/reyhan-tunell-dashboard","type":"project","description":"reyhanTunell web dashboard.","keywords":["laravel","reyhanTunell","dashboard"],"license":"MIT",
  "require":{"php":"^8.3|^8.4|^8.5","laravel/framework":"^13.0","laravel/tinker":"^3.0"},
